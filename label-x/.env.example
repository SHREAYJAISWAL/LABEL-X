# Copy to .env and edit as needed. Defaults work for local, non-Docker use
# except for the database section, which you must fill in yourself — no
# credentials are hardcoded anywhere in the application.

# --- Backend ---
APP_NAME=label-x-backend
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# --- Frontend ---
BACKEND_URL=http://localhost:8000

# --- Database (Phase 2) ---
# Either set DATABASE_URL directly, or leave it unset and the individual
# POSTGRES_* variables below will be assembled into one automatically.
# DATABASE_URL=postgresql+psycopg2://labelx:changeme@localhost:5432/labelx

POSTGRES_USER=labelx
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labelx

# Dimensionality of the regulatory-rule embedding vector. Not used until the
# RAG phase picks an embedding model, but the column is created now
# (pgvector-prepared) so no migration is needed later. Common choices:
# 384 (MiniLM), 768 (base BERT-sized), 1536 (OpenAI ada-002 / text-embed-3-small).
EMBEDDING_DIM=1536

# Set to true to auto-run Base.metadata.create_all() on backend startup.
# Convenient for local/demo use; migrations (alembic) are the source of
# truth otherwise, e.g. in any shared or production-like environment.
DB_AUTO_CREATE=false
